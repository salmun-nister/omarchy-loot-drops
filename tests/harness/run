#!/usr/bin/env bash
# Runs the real widget in a real Quickshell instance with the installed shell
# modules on the import path. This exercises the fetch, the seen-state file and
# the panel for real, which the portable checks cannot do.
#
# The state directory is redirected to a temporary one so a harness run cannot
# touch real user state, and notifications are disabled by the harness settings
# so a run cannot fire a desktop notification.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../.." && pwd)"
shell_dir="${OMARCHY_PATH:-/usr/share/omarchy}/shell"

if [[ ! -d "$shell_dir/Ui" ]]; then
  echo "SKIP: $shell_dir/Ui not found; is Omarchy 4 installed?" >&2
  exit 0
fi

shim="$(mktemp -d)"
state="$(mktemp -d)"
trap 'rm -rf "$shim" "$state"' EXIT
mkdir -p "$shim/qs"
ln -s "$shell_dir/Ui" "$shim/qs/Ui"
ln -s "$shell_dir/Commons" "$shim/qs/Commons"

output="$(QML_IMPORT_PATH="$shim${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" \
LOOT_DROPS_HARNESS=1 \
LOOT_DROPS_DIR="$root" \
LOOT_DROPS_STATE="$state" \
  quickshell -p "$here/shell.qml" "$@" 2>&1)" || true
printf '%s\n' "$output"

# A panel whose row model is empty, or whose rows carry no height, renders
# nothing while the widget's data stays correct — which is exactly the bug that
# shipped twice. Validate the row report here so a blank panel fails the harness.
if ! printf '%s' "$output" | python3 -c '
import json, os, sys

MIN_ROW_HEIGHT = int(os.environ.get("LOOT_MIN_ROW", "14"))
raw = sys.stdin.read()
marker = "HARNESS rows "
start = raw.find(marker)
if start < 0:
    print("FAIL: harness produced no row report", file=sys.stderr)
    raise SystemExit(1)
start += len(marker)
depth, end = 0, None
for i, ch in enumerate(raw[start:], start):
    if ch == "{":
        depth += 1
    elif ch == "}":
        depth -= 1
        if depth == 0:
            end = i + 1
            break
if end is None:
    print("FAIL: harness row report was truncated", file=sys.stderr)
    raise SystemExit(1)

data = json.loads(raw[start:end])
rows, headers = data["rowCount"], data["headers"]
rendered = data.get("renderedRows", -1)
metrics = data.get("metrics", {})

print("  panel rows: %d  view count: %s  contentHeight: %s  headers: %s"
      % (rows, rendered, metrics.get("contentHeight"), ", ".join(headers)))

# The view must have built the rows, not merely had a valid model.
if rendered != rows:
    print("FAIL: the view built %s rows from a model of %d; the panel would "
          "render blank" % (rendered, rows), file=sys.stderr)
    raise SystemExit(1)

# The rows must carry height. A Repeater builds every delegate and positions
# none of them, which left a correct count above a blank panel.
if not data.get("laidOut"):
    print("FAIL: %d rows built but the list has no height; the panel would "
          "render blank" % rows, file=sys.stderr)
    raise SystemExit(1)

# The hero must sit outside the scrolling list, directly above it. It used to
# be the header of that list, so it scrolled away with the rows.
pinned_bottom = metrics.get("pinnedBottom")
list_y = metrics.get("listY")
if pinned_bottom is None or list_y is None:
    print("FAIL: the harness cannot see the pinned hero", file=sys.stderr)
    raise SystemExit(1)
if (metrics.get("pinnedHeight") or 0) <= 0:
    print("FAIL: the pinned hero has no height; the panel would render blank",
          file=sys.stderr)
    raise SystemExit(1)
if abs(pinned_bottom - list_y) > 1.5:
    print("FAIL: the hero is not pinned directly above the list "
          "(hero bottom %s, list top %s); it would scroll with the rows"
          % (pinned_bottom, list_y), file=sys.stderr)
    raise SystemExit(1)

# The footer must stay below the list rather than ride along as list content:
# the games scroll between the two rules and the controls stay put.
footer_y = metrics.get("footerY")
footer_height = metrics.get("footerHeight")
list_bottom = metrics.get("listBottom")
if footer_y is None or footer_height is None or list_bottom is None:
    print("FAIL: the harness cannot see the pinned footer", file=sys.stderr)
    raise SystemExit(1)
if footer_height <= 0:
    print("FAIL: the pinned footer has no height; the controls would vanish",
          file=sys.stderr)
    raise SystemExit(1)
if abs(footer_y - list_bottom) > 1.5:
    print("FAIL: the footer is not directly below the scrolling list "
          "(list bottom %s, footer top %s)" % (list_bottom, footer_y),
          file=sys.stderr)
    raise SystemExit(1)

# Every row is at least a caption tall, so a list of N rows cannot legitimately
# be shorter than N pixels. A blank panel measured 18px for 7 rows.
content_height = metrics.get("contentHeight") or 0
if content_height < rows * MIN_ROW_HEIGHT:
    print("FAIL: contentHeight %s is under %dpx for %d rows; the rows are not "
          "stacked and the panel would render blank"
          % (content_height, rows * MIN_ROW_HEIGHT, rows), file=sys.stderr)
    raise SystemExit(1)

for store in ("steam", "epic", "gog", "amazon"):
    if store not in headers:
        print("FAIL: no header for %s in %s" % (store, headers), file=sys.stderr)
        raise SystemExit(1)
'; then
  exit 1
fi

echo "PASS: harness (panel rows built, sized and positioned)"
